rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Fonctions utilitaires ----------
    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'member') == 'admin';
    }

    // Jour courant (UTC) sous forme 20261126 : sert à limiter à un booster par jour.
    function today() {
      return request.time.year() * 10000 + request.time.month() * 100 + request.time.day();
    }

    // ---------- Utilisateurs ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Un membre ne peut créer son profil qu'avec le rôle "member".
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.lastBoosterDay == 0
        && request.resource.data.keys().hasOnly(['name', 'email', 'delegation', 'role', 'createdAt', 'lastBoosterDay']);

      // Un membre peut changer son nom, sa délégation et ouvrir son booster du jour (une fois par jour).
      // Il ne peut JAMAIS modifier son rôle.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('role', 'member') == resource.data.get('role', 'member')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'delegation', 'lastBoosterDay'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastBoosterDay'])
          || (request.resource.data.lastBoosterDay == today()
              && resource.data.get('lastBoosterDay', 0) < today())
        );

      // L'administrateur peut tout modifier (ex. changer un rôle).
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Collection de cartes de chaque membre.
      match /collection/{cardId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

        // Les cartes ne s'ajoutent que dans le même lot que l'ouverture du booster du jour.
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['cardId', 'count', 'firstAt'])
          && request.resource.data.cardId == cardId
          && request.resource.data.count is int
          && request.resource.data.count >= 1 && request.resource.data.count <= 5
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.get('lastBoosterDay', 0) == today()
          && get(/databases/$(database)/documents/users/$(uid)).data.get('lastBoosterDay', 0) < today();

        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
          && request.resource.data.count > resource.data.count
          && request.resource.data.count <= resource.data.count + 5
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.get('lastBoosterDay', 0) == today()
          && get(/databases/$(database)/documents/users/$(uid)).data.get('lastBoosterDay', 0) < today();

        allow delete: if isAdmin();
      }
    }

    // ---------- Contenus publics en lecture, réservés à l'administrateur en écriture ----------
    match /events/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /news/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /cards/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /words/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /daily/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /parashot/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /anecdotes/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /quiz/{id}         { allow read: if true; allow write: if isAdmin(); }

    // ---------- Inscriptions aux événements ----------
    match /events/{eventId}/rsvps/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['eventId', 'uid', 'name', 'answer', 'createdAt'])
        && request.resource.data.eventId == eventId
        && request.resource.data.uid == uid
        && request.resource.data.answer in ['yes', 'no']
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Lecture des inscriptions (requête de groupe) pour les membres connectés.
    match /{path=**}/rsvps/{id} {
      allow read: if signedIn();
    }
  }
}
